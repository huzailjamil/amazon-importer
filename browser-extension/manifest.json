{
  "manifest_version": 3,
  "name": "Product Importer Amazon Helper",
  "version": "1.1.0",
  "description": "Sends Amazon product facts, media, specifications and variations to Product Importer.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "tabs"],
  "host_permissions": ["https://importer.legendsmarketing.co.uk/*"],
  "content_scripts": [
    {
      "matches": ["https://importer.legendsmarketing.co.uk/*"],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Copy Amazon product",
    "default_popup": "popup.html"
  }
}
