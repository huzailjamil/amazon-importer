generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  LOCAL_DRAFT
  SHOPIFY_DRAFT
  ERROR
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  stores       Store[]
  products     Product[]
  activities   ActivityLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Store {
  id             String   @id @default(cuid())
  userId         String
  platform       String   @default("shopify")
  name           String
  domain         String
  accessTokenEnc String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([userId, domain])
  @@index([userId])
}

model Product {
  id                String        @id @default(cuid())
  userId            String
  storeId           String?
  sourceType        String        @default("manual")
  sourceUrl         String?       @db.Text
  sourceExternalId  String?
  title             String
  descriptionHtml   String        @db.LongText
  vendor             String?
  productType        String?
  seoTitle           String?
  metaDescription   String?       @db.Text
  primaryKeyword    String?
  tags               Json
  secondaryKeywords Json
  imageAltText       Json
  images             Json
  rawData            Json?
  seoScore           Int?
  status             ProductStatus @default(LOCAL_DRAFT)
  shopifyProductId   String?
  lastError          String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  store              Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([storeId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
