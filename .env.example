# Public HTTPS URL assigned to the cPanel Node.js application
APP_URL=https://importer.example.com

# MySQL connection created in cPanel
DATABASE_URL=mysql://database_user:database_password@localhost:3306/database_name

# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters

# OpenAI used for SEO rewriting
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5-mini

# Shopify app credentials and API configuration
SHOPIFY_CLIENT_ID=replace_with_shopify_client_id
SHOPIFY_CLIENT_SECRET=replace_with_shopify_client_secret
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_API_VERSION=2026-07

# Keep disabled until the production setup has been tested
ALLOW_REGISTRATION=false

# Used once by npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

NODE_ENV=production
